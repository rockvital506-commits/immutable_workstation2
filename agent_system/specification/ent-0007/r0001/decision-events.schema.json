        },
        "basis": {
          "$ref": "urn:agent-system:schema:catalog-base:1#/$defs/approve_revision/properties/basis"
        },
        "decision_type": {
          "const": "restrict_use"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:\\*|[a-z][a-z0-9_.-]*)$(?![\\s\\S])"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "areas": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:\\*|[a-z][a-z0-9_.-]*)$(?![\\s\\S])"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "operations",
            "areas"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "subject",
        "artifacts",
        "actor_role",
        "recorded_by",
        "decision_date",
        "statement",
        "statement_form",
        "basis",
        "decision_type",
        "reason",
        "scope"
