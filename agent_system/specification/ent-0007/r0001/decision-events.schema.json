            "decision_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 2,
                "pattern": "^/"
