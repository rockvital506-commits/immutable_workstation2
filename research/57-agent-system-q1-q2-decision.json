 "owner_statement": {
  "verbatim": "Q1. - не регистрировать; Q2 - принять замену строки",
  "language": "ru",
  "context": "ответ на два вопроса раздела 9 отчёта 56 (Q1 — регистрация ревизии, Q2 — замена строки раздела границ)"
 },
 "decisions": [
  {
   "id": "Q1",
   "question": "Регистрировать ли точную ревизию свода с собственным составом и полномочием?",
   "answer": "не регистрировать",
   "effect": "нормативная регистрация и approval не выполняются; предыдущее принятие остаётся принятием кандидатного текста, а не ревизии",
   "grants": []
  },
  {
   "id": "Q2",
   "question": "Переносить раздел границ как есть или принять замену строки?",
   "answer": "принять замену строки",
   "effect": "создана версия текста v2: одна строка раздела границ заменена; остальные байты не тронуты. Принятие 54 относится к версии без замены и на v2 само по себе не переносится",
   "scope": "только эта одна строка; любые дальнейшие правки требуют отдельного решения",
   "grants": []
  }
 ],
